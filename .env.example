# Application
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8082
APP_JWT_SECRET=replace-with-a-strong-secret-of-at-least-32-characters
APP_ACCESS_TOKEN_EXPIRATION_MS=1800000
APP_REFRESH_TOKEN_EXPIRATION_MS=604800000

# MySQL
MYSQL_URL=jdbc:mysql://localhost:3306/xingmang_db?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RocketMQ
ROCKETMQ_NAME_SERVER=127.0.0.1:9876
ROCKETMQ_PRODUCER_GROUP=xingmang-producer-group
MOMENTS_CONSUMER_ENABLED=true

# MinIO
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET_NAME=xingmang-api

# Baidu Body Analysis SDK, optional
BAIDU_BODY_APP_ID=
BAIDU_BODY_API_KEY=
BAIDU_BODY_SECRET_KEY=
